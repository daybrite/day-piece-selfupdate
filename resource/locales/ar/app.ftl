check_automatically = التحقق من التحديثات تلقائيًا
frequency = تكرار التحقق
interval_daily = يوميًا
interval_weekly = أسبوعيًا
interval_monthly = شهريًا
auto_download = تنزيل التحديثات تلقائيًا
last_checked = آخر تحقق
never = أبدًا
just_now = الآن
minutes_ago = { $n ->
    [zero] منذ أقل من دقيقة
    [one] منذ دقيقة
    [two] منذ دقيقتين
    [few] منذ { $n } دقائق
    [many] منذ { $n } دقيقة
   *[other] منذ { $n } دقيقة
}
hours_ago = { $n ->
    [one] منذ ساعة
    [two] منذ ساعتين
    [few] منذ { $n } ساعات
   *[other] منذ { $n } ساعة
}
days_ago = { $n ->
    [one] منذ يوم
    [two] منذ يومين
    [few] منذ { $n } أيام
   *[other] منذ { $n } يومًا
}
status = الحالة
check_now = التحقق الآن
download_update = تنزيل التحديث
quit_and_install = الإنهاء والتثبيت
managed = يدير التحديثات المتجر أو مدير الحزم الذي ثبّت هذا التطبيق.
status_idle = لم يتم التحقق بعد.
status_checking = جارٍ التحقق من التحديثات…
status_current = هذا التطبيق محدّث.
status_available = يتوفر تحديث.
status_missing = لم يتم العثور على تحديث منزّل.
status_unconfigured = لا يحتوي هذا الإصدار على مفتاح توقيع التحديثات، لذا لا يمكنه التحقق منها.
status_invalid = تعذّر التحقق من التحديث. لم يتغيّر هذا التطبيق.
status_preparing = جارٍ تنزيل التحديث والتحقق منه…
status_ready = التحديث جاهز. أنهِ التطبيق لتثبيته وإعادة فتحه.
status_failed = تعذّر إعداد التحديث. لم يتغيّر هذا التطبيق.
